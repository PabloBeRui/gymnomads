# Variables de entorno para el Frontend de GymNomads
# Environment variables for the GymNomads Frontend

# URL completa de la API (incluyendo /api)
# Full API URL (including /api)
# Se usa para todas las llamadas a servicios (ej: /api/users/login)
# Used for all service calls (e.g., /api/users/login)
VITE_API_BASE_URL=

# URL raíz del servidor backend (SIN /api)
# Root URL of the backend server (WITHOUT /api)
# Se usa para construir URLs a archivos estáticos (ej: /uploads/profile_pictures/...)
# Used to build URLs for static files (e.g., /uploads/profile_pictures/...)
VITE_BACKEND_BASE_URL=

# Claves de EmailJS (Consíguelas en el panel de emailjs.com)
# EmailJS Keys (Get them from your dashboard at emailjs.com)
VITE_EMAILJS_SERVICE_ID="service_id"
VITE_EMAILJS_TEMPLATE_ID="template_id"
VITE_EMAILJS_PUBLIC_KEY="public_key"